{
  "llm": "deepseek/deepseek-v4-flash",
  "summary_llm": "deepseek/deepseek-v4-flash",
  "embedding": "openai/nomic-embed-text",
  "parsing": {
    "multimodal": "OFF"
  },
  "llm_config": {
    "model_list": [
      {
        "model_name": "deepseek/deepseek-v4-flash",
        "litellm_params": {
          "model": "deepseek/deepseek-v4-flash",
          "api_key": "os.environ/DEEPSEEK_API_KEY",
          "timeout": 300
        }
      }
    ]
  },
  "summary_llm_config": {
    "model_list": [
      {
        "model_name": "deepseek/deepseek-v4-flash",
        "litellm_params": {
          "model": "deepseek/deepseek-v4-flash",
          "api_key": "os.environ/DEEPSEEK_API_KEY",
          "timeout": 300
        }
      }
    ]
  },
  "embedding_config": {
    "model_list": [
      {
        "model_name": "openai/nomic-embed-text",
        "litellm_params": {
          "model": "openai/nomic-embed-text",
          "api_base": "http://localhost:11434/v1",
          "api_key": "ollama",
          "timeout": 120
        }
      }
    ]
  },
  "agent": {
    "index": {
      "concurrency": 1,
      "recurse_subdirectories": true,
      "paper_directory": "~/Sync/biblio/New",
      "name": "biblio-new-deepseek"
    }
  }
}
