# Hermes Agent Environment Configuration — NON-SECRET SETTINGS ONLY
# API keys come from `pass` via ~/.local/bin/hermes-secrets (secrets.command).
# Do NOT put keys here. Add them to ~/.config/agent-secrets/registry instead.

# =============================================================================
# SEARCH / TOOLS (no secrets)
# =============================================================================
# SearXNG - self-hosted metasearch (plugin web/searxng)
SEARXNG_URL=http://localhost:8080

# Browser automation (Browserbase)
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================
# Container images (for singularity/docker/modal backends)
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# Default command timeout in seconds
TERMINAL_TIMEOUT=60

# Cleanup inactive environments after this many seconds
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# TELEGRAM (allowlist only — token from registry)
# =============================================================================
TELEGRAM_ALLOWED_USERS=877358857
TELEGRAM_HOME_CHANNEL=877358857

# =============================================================================
# HOME ASSISTANT
# =============================================================================
HASH_URL=http://homeassistant.local:8123

# =============================================================================
# OPTIONAL BASE URL OVERRIDES (uncomment if needed)
# =============================================================================
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OLLAMA_BASE_URL=https://ollama.com/v1
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# KIMI_BASE_URL=https://api.kimi.com/coding/v1
# ARCEE_BASE_URL=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_CN_BASE_URL=https://api.minimaxi.com/v1
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# HERMES_QWEN_BASE_URL=https://portal.qwen.ai/v1
# ALIBABA_TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# STT_OPENAI_BASE_URL=https://api.openai.com/v1
