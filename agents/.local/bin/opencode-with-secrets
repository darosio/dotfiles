#!/usr/bin/env sh
#
# Launch OpenCode with provider keys resolved from `pass` at start time, so no
# secret needs to be pasted into `opencode auth login` / opencode.db (OpenCode
# v2 stores credentials in SQLite and, unlike pi, has no command-reference
# key form).
#
# Which keys get exported is decided by the shared registry
# (~/.config/agent-secrets/registry) INTERSECTED with OpenCode's own provider
# env list (~/.cache/opencode/models.json, per-provider "env" arrays — e.g.
# alibaba-token-plan -> ALIBABA_TOKEN_PLAN_API_KEY). Registry rows that are
# not OpenCode provider keys (EXA, TELEGRAM, or providers OpenCode does not
# know) are skipped automatically.
#
# --standalone makes the CLI spawn a private server as its child, which
# inherits these exports; the shared background service would NOT see them.
# It is appended LAST because opencode's parser only accepts it after the
# subcommand.
#
# Usage: opencode-with-secrets [opencode args...]
#   e.g. opencode-with-secrets run -m alibaba-token-plan/auto "hi"
#
# A missing/locked pass entry silently falls back to the ambient environment
# instead of breaking the launch.

set -eu

AGENT_SECRETS="$HOME/.local/bin/agent-secrets"
OC_MODELS="${OPENCODE_MODELS_PATH:-$HOME/.cache/opencode/models.json}"

# Env vars OpenCode accepts for its built-in providers (empty file-safe).
known_env_vars=$(
  if [ -f "$OC_MODELS" ]; then
    jq -r '[.[] | (.env // [])[]] | .[]' "$OC_MODELS" 2> /dev/null | sort -u
  fi
) || known_env_vars=""

# Rows into a temp file, NOT a pipe: `list | while` would run the loop in a
# subshell and its exports would never reach the exec'd opencode.
rows_file=$(mktemp)
"$AGENT_SECRETS" list > "$rows_file"

while read -r var entry _pi_id; do
  [ -n "${var:-}" ] || continue
  printf '%s\n' "$known_env_vars" | grep -qxF -- "$var" || continue
  value=$("$AGENT_SECRETS" "$entry")
  [ -n "$value" ] || continue
  export "$var=$value"
done < "$rows_file"
rm -f "$rows_file"

exec opencode "$@" --standalone
