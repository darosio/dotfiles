#!/usr/bin/env sh
#
# Emit Hermes secrets as a KEY=VALUE blob for the `secrets.command` source
# configured in ~/.hermes/config.yaml. Hermes runs this via /bin/sh and parses
# stdout; keys stay in `pass`, so no secret is ever committed to this repo.
#
# Keep it fast and non-interactive: Hermes kills the helper after
# secrets.command.helper_timeout_seconds. A locked gpg-agent makes `pass show`
# raise a pinentry prompt, which blows that timeout and yields no secrets at
# all -- unlock the agent before starting Hermes headless.

PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/Sync/.pass}"
export PASSWORD_STORE_DIR

# emit VAR pass/entry
# Skips silently when an entry is missing or empty so that one unavailable
# secret cannot void the whole blob.
emit() {
  value=$(pass show "$2" 2> /dev/null | head -n 1)
  [ -n "$value" ] || return 0
  printf '%s=%s\n' "$1" "$value"
}

# Model providers (plugins model-providers/gemini, model-providers/deepseek)
emit GEMINI_API_KEY cloud/gemini_API_key
emit DEEPSEEK_API_KEY cloud/deepseek

# Anthropic API access (plugin model-providers/anthropic).
# Deliberately NOT ANTHROPIC_TOKEN: that variable is first in
# resolve_anthropic_token(), so a key here would shadow the Claude Code OAuth
# token (~/.claude/.credentials.json) that provides plan access. As
# ANTHROPIC_API_KEY the console key stays a fallback below the plan token.
emit ANTHROPIC_API_KEY cloud/claude_api_dpa

# Tools (plugin web/exa; Telegram gateway)
emit EXA_API_KEY cloud/exa_api_key.el
emit TELEGRAM_BOT_TOKEN cloud/telegram_bot_token
