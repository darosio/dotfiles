#!/usr/bin/env sh
#
# Resolve secrets from `pass` for the AI coding agents, driven by ONE
# registry file: ~/.config/agent-secrets/registry
#   format:  ENV_VAR  pass-entry  [pi-provider-id]
#
# Commands:
#   agent-secrets <pass-entry>   print the first line of the entry (no
#                                trailing newline) — this is pi's command-key
#                                form ("key": "!…agent-secrets cloud/…")
#   agent-secrets list           print the registry rows: VAR ENTRY [PI-ID]
#                                (normalized, no secret values)
#   agent-secrets emit           print VAR=VALUE for every registry row that
#                                resolves — Hermes's whole env blob
#
# Consumers:
#   Hermes   ~/.local/bin/hermes-secrets        -> exec agent-secrets emit
#   pi       ~/.local/bin/pi-pass-auth          -> agent-secrets list (pi IDs)
#   OpenCode ~/.local/bin/opencode-with-secrets -> agent-secrets list (exports)
#
# Empty output for a missing/locked entry is intentional: all three tools
# treat an unresolved credential as "not configured", never as corruption.
# Keep it fast and non-interactive — a locked gpg-agent makes `pass show`
# raise pinentry, which blows consumer timeouts. Unlock first (quick test:
# pass show cloud/qwencloud >/dev/null).

PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/Sync/.pass}"
export PASSWORD_STORE_DIR

REGISTRY="${AGENT_SECRETS_REGISTRY:-$HOME/.config/agent-secrets/registry}"

resolve() {
  pass show "$1" 2> /dev/null | head -n 1 | tr -d '\r'
}

# Normalized registry rows: "VAR ENTRY [PI-ID]"; comments/blanks dropped.
rows() {
  if [ ! -f "$REGISTRY" ]; then
    echo "agent-secrets: no registry at $REGISTRY" >&2
    return 1
  fi
  awk '
    /^[[:space:]]*(#|$)/ { next }
    { sub(/[[:space:]]#.*$/, ""); if (NF >= 2) print $1, $2, $3 }
  ' "$REGISTRY"
}

case "${1:-}" in
  list)
    rows
    ;;
  emit)
    rows | while read -r var entry _pi_id; do
      value=$(resolve "$entry")
      [ -n "$value" ] || continue
      printf '%s=%s\n' "$var" "$value"
    done
    ;;
  "")
    echo "usage: agent-secrets <pass-entry> | list | emit" >&2
    exit 2
    ;;
  *)
    resolve "$1"
    ;;
esac
