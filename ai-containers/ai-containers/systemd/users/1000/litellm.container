# LiteLLM OpenAI-compatible gateway. Cloud API keys are NOT baked in:
# they come from ~/.config/containers/litellm.env, generated by
# ai-containers.stow.sh from pass. Missing file -> gateway still starts,
# only cloud routes fail (matches the old ${VAR:-} behaviour).
[Unit]
Description=LiteLLM gateway (quadlet)

[Container]
Image=ghcr.io/berriai/litellm:main-latest
ContainerName=litellm
AutoUpdate=registry
PublishPort=127.0.0.1:4000:4000
Volume=/home/dan/ai-containers/litellm/config.yaml:/app/config.yaml:ro
Volume=litellm_copilot_auth:/root/.config/litellm
EnvironmentFile=-/home/dan/.config/containers/litellm.env
Exec=--config /app/config.yaml --port 4000

[Service]
Restart=always
# No [Install]: on-demand only (`aic up litellm`), as with podman-compose before.
